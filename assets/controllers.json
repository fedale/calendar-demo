{
    "controllers": {
        "@fedale/calendar-bundle": {
            "now": {
                "enabled": true,
                "fetch": "lazy"
            },
            "button": {
                "enabled": true,
                "fetch": "lazy"
            },
            "interact": {
                "enabled": true,
                "fetch": "eager"
            },
            "ui-settings": {
                "enabled": true,
                "fetch": "lazy"
            }
        },
        "@symfony/ux-live-component": {
            "live": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "@symfony/ux-live-component/dist/live.min.css": true
                }
            }
        }
    },
    "entrypoints": []
}
